---
// Override of Starlight's MarkdownContent: the one-sentence answer above the page body
// and the page notes (scope, caveat, dates, sources) after it, all in the same
// container as the body. Extractors that keep only the main article (Readability and
// the like) would drop them anywhere else.
// The same frontmatter fields also produce the Markdown twin (src/lib/page-md.mjs)
// and the JSON-LD (src/routeData.ts).
import '@astrojs/starlight/style/markdown.css';
import { SITE, LABELS, LOCALES, pageId, localeOf, mdPath, llmsPath, withBase, isoDate } from '../lib/site.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const id = pageId(Astro.locals.starlightRoute.entry.id);
const t = LABELS[localeOf(id).lang];
// Starlight's built-in 404 page has no contract fields. It gets links to each
// language's home page and page list instead, so a wrong URL is not a dead end.
const hasFacts = Boolean(data.lastVerified && data.sources);
// A note for agents that read the HTML: scope and caveat, which sighted readers find in
// the page notes after the body, and where the Markdown is. It is hidden with a CSS
// class (not `hidden` or `aria-hidden`, which extractors treat as "drop this").
const zh = localeOf(id).lang === 'zh-TW';
const agentNote = hasFacts
	? zh
		? `${t.appliesTo}：${data.appliesTo}。${t.caveat}：${data.caveat} Markdown：${SITE}${mdPath(id)} 。所有頁面：${SITE}${llmsPath(localeOf(id))} 、${SITE}/index.json 。`
		: `${t.appliesTo}: ${data.appliesTo}. ${t.caveat}: ${data.caveat} Markdown: ${SITE}${mdPath(id)} . All pages: ${SITE}${llmsPath(localeOf(id))} , ${SITE}/index.json .`
	: '';
---

<div class="sl-markdown-content">
{/* No wrapper around the note, the answer and the page notes: as direct children of
     the article container they make it the element a readability-style extractor
     keeps, together with the body. */}
{hasFacts && <>
<p class="not-content agent-note">{agentNote}</p>
<p class="not-content answer">{data.description}</p>
</>}
{!hasFacts && <div class="not-content not-found">
<p>Page paths are lower-case: <code>{withBase('/repos/kage/')}</code>, not <code>{withBase('/repos/Kage/')}</code>. 頁面路徑一律小寫。</p>
<ul>
	{LOCALES.map((locale) => (
		<li lang={locale.lang}>
			{locale.label}: <a href={withBase(locale.dir ? `/${locale.dir}/` : '/')}>{locale.lang === 'zh-TW' ? '首頁' : 'Home'}</a>, <a href={withBase(llmsPath(locale))}>{locale.lang === 'zh-TW' ? '所有頁面清單' : 'list of all pages'}</a>
		</li>
	))}
</ul>
</div>}
<slot />
{/* Page notes after the body: scope, dates, sources and the other formats. */}
{hasFacts && <dl class="not-content facts">
	<dt>{t.appliesTo}</dt>
	<dd>{data.appliesTo}</dd>
	<dt>{t.caveat}</dt>
	<dd>{data.caveat}</dd>
	{
		data.effectiveDate && (
			<>
				<dt>{t.effectiveDate}</dt>
				<dd>
					<time datetime={isoDate(data.effectiveDate)}>{isoDate(data.effectiveDate)}</time>
				</dd>
			</>
		)
	}
	<dt>{t.lastVerified}</dt>
	<dd><time datetime={isoDate(data.lastVerified)}>{isoDate(data.lastVerified)}</time></dd>
	{
		data.repo && (
			<>
				<dt>{t.repo}</dt>
				<dd>
					<a href={`https://github.com/${data.repo}`}>github.com/{data.repo}</a>
				</dd>
			</>
		)
	}
	<dt>{t.sources}</dt>
	<dd>
		<ul>
			{data.sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}
		</ul>
	</dd>
	<dt>{t.markdown}</dt>
	<dd><a href={withBase(mdPath(id))}>{mdPath(id)}</a></dd>
	<dt>{t.allPages}</dt>
	<dd class="outputs"><a href={withBase(llmsPath(localeOf(id)))}>{llmsPath(localeOf(id))}</a>{zh ? '、' : ', '}<a href={withBase('/index.json')}>/index.json</a></dd>
</dl>}
</div>

<style>
	.agent-note {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.not-found {
		margin-top: 1.5rem;
		font-size: var(--sl-text-sm);
	}
	.answer {
		margin-top: 0;
		padding-inline-start: 1.25rem;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--sl-color-white);
		position: relative;
	}
	.answer::before {
		content: '>';
		position: absolute;
		inset-inline-start: 0;
		color: var(--sl-color-accent);
	}
	.facts {
		display: grid;
		grid-template-columns: minmax(6.5rem, max-content) 1fr;
		gap: 0.35rem 1.25rem;
		margin-top: 3.5rem;
		margin-bottom: 0.5rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	dt {
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0;
		min-width: 0;
		overflow-wrap: anywhere;
		color: var(--sl-color-text);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		color: var(--sl-color-text-accent);
	}
	@media (max-width: 36rem) {
		.facts {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
		dd {
			margin-bottom: 0.5rem;
		}
	}
</style>
