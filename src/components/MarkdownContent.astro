---
// Override of Starlight's MarkdownContent: the one-sentence answer and the facts
// block, placed in the same container as the page body. Extractors that keep only
// the main article (Readability and the like) would drop them anywhere else.
// The same frontmatter fields also produce the Markdown twin (src/lib/page-md.mjs)
// and the JSON-LD (src/routeData.ts).
import '@astrojs/starlight/style/markdown.css';
import { SITE, LABELS, pageId, localeOf, mdPath, isoDate } from '../lib/site.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const id = pageId(Astro.locals.starlightRoute.entry.id);
const t = LABELS[localeOf(id).lang];
// Starlight's built-in 404 page has no contract fields; it gets the title only.
const hasFacts = Boolean(data.lastVerified && data.sources);
// A pointer for agents that read the HTML. It is hidden from sighted readers with a
// CSS class (not `hidden` or `aria-hidden`, which extractors treat as "drop this").
const zh = localeOf(id).lang === 'zh-TW';
const agentNote = zh
	? `本頁的 Markdown 版本：${SITE}${mdPath(id)} 。所有頁面的清單：${SITE}/llms.txt （Markdown）、${SITE}/index.json （JSON）。`
	: `Markdown version of this page: ${SITE}${mdPath(id)} . List of all pages: ${SITE}/llms.txt (Markdown), ${SITE}/index.json (JSON).`;
---

<div class="sl-markdown-content">
{hasFacts && <div class="not-content page-facts">
<p class="agent-note">{agentNote}</p>
<p class="answer">{data.description}</p>
<dl class="facts">
	<dt>{t.appliesTo}</dt>
	<dd>{data.appliesTo}</dd>
	<dt>{t.caveat}</dt>
	<dd>{data.caveat}</dd>
	{
		data.effectiveDate && (
			<>
				<dt>{t.effectiveDate}</dt>
				<dd>
					<time datetime={isoDate(data.effectiveDate)}>{isoDate(data.effectiveDate)}</time>
				</dd>
			</>
		)
	}
	<dt>{t.lastVerified}</dt>
	<dd><time datetime={isoDate(data.lastVerified)}>{isoDate(data.lastVerified)}</time></dd>
	{
		data.repo && (
			<>
				<dt>{t.repo}</dt>
				<dd>
					<a href={`https://github.com/${data.repo}`}>github.com/{data.repo}</a>
				</dd>
			</>
		)
	}
	<dt>{t.sources}</dt>
	<dd>
		<ul>
			{data.sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}
		</ul>
	</dd>
	<dt>{t.markdown}</dt>
	<dd><a href={mdPath(id)}>{mdPath(id)}</a></dd>
</dl>
</div>}
<slot />
</div>

<style>
	.agent-note {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.answer {
		margin-top: 0;
		padding-inline-start: 1.25rem;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: var(--sl-color-white);
		position: relative;
	}
	.answer::before {
		content: '>';
		position: absolute;
		inset-inline-start: 0;
		color: var(--sl-color-accent);
	}
	.facts {
		display: grid;
		grid-template-columns: minmax(6.5rem, max-content) 1fr;
		gap: 0.35rem 1.25rem;
		margin-top: 1.75rem;
		margin-bottom: 2.5rem;
		padding: 0.9rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}
	dt {
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0;
		min-width: 0;
		overflow-wrap: anywhere;
		color: var(--sl-color-text);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		color: var(--sl-color-text-accent);
	}
	@media (max-width: 36rem) {
		.facts {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
		dd {
			margin-bottom: 0.5rem;
		}
	}
</style>
