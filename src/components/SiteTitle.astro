---
// Override of Starlight's SiteTitle: the site name plus a row of keyboard-hint links.
// The bracketed key hints are drawn by CSS (`[data-key]::before`), so they never
// reach the text an agent extracts from the page.
import { pageId, localeOf, mdPath, llmsPath, withBase } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry } = Astro.locals.starlightRoute;
const zh = localeOf(entry.id).lang === 'zh-TW';
const links = [
	{ key: 'H', label: zh ? '首頁' : 'Home', href: siteTitleHref },
	...(entry.data.lastVerified
		? [{ key: 'M', label: 'Markdown', href: withBase(mdPath(pageId(entry.id))) }]
		: []),
	{ key: 'L', label: 'llms.txt', href: withBase(llmsPath(localeOf(entry.id))) },
	{ key: 'J', label: 'index.json', href: withBase('/index.json') },
];
---

<a href={siteTitleHref} class="site-title" translate="no">{siteTitle}</a>
<nav class="keys" aria-label={zh ? '快速鍵連結' : 'Shortcut links'}>
	{
		links.map((link) => (
			<a href={link.href} data-key={link.key} aria-keyshortcuts={link.key.toLowerCase()}>
				{link.label}
			</a>
		))
	}
</nav>

<script is:inline>
	// Single-key shortcuts for the links above. Ignored while typing or with modifier keys.
	document.addEventListener('keydown', (event) => {
		if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
		const target = event.target;
		if (target instanceof HTMLElement) {
			if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
		}
		if (document.querySelector('dialog[open]')) return;
		const link = document.querySelector(`nav.keys a[data-key="${event.key.toUpperCase()}"]`);
		if (link instanceof HTMLAnchorElement) link.click();
	});
</script>

<style>
	.site-title {
		font-weight: 700;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.site-title::before {
		content: '~/';
		color: var(--sl-color-accent);
	}
	.site-title::after {
		content: '█';
		margin-inline-start: 0.15em;
		color: var(--sl-color-accent);
		animation: blink 1.2s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.site-title::after {
			animation: none;
		}
	}
	.keys {
		display: none;
		gap: 1.25rem;
		margin-inline-start: 2rem;
		font-size: var(--sl-text-xs);
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.keys {
			display: flex;
		}
	}
	.keys a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.keys a::before {
		content: '[' attr(data-key) '] ';
		color: var(--sl-color-accent);
	}
	.keys a:hover,
	.keys a:focus-visible {
		color: var(--sl-color-white);
	}
</style>
