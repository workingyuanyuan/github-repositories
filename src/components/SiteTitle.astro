---
// Override of Starlight's SiteTitle: the site name and a link to the first page of each
// top-level sidebar group, in the sidebar's order and labels. A site with one group, as
// this one has now, shows no section links. The Markdown twin, llms.txt and index.json
// are linked from the page notes (MarkdownContent.astro).
import { LABELS, localeOf } from '../lib/site.mjs';

const { siteTitle, siteTitleHref, entry, sidebar } = Astro.locals.starlightRoute;
const t = LABELS[localeOf(entry.id).lang];
const links = (entries) => entries.flatMap((e) => (e.type === 'link' ? [e] : links(e.entries)));
const groups = sidebar
	.filter((e) => e.type === 'group')
	.map((group) => {
		const inner = links(group.entries);
		return { label: group.label, href: inner[0]?.href, current: inner.some((e) => e.isCurrent) };
	})
	.filter((s) => s.href);
const sections = groups.length > 1 ? groups : [];
---

<a href={siteTitleHref} class="site-title" translate="no"><svg class="site-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" class="ground" /><path d="M8 9l7 7-7 7" class="mark" fill="none" stroke-width="3.5" stroke-linecap="square" /><rect x="17" y="21" width="8" height="3.5" class="glyph" /></svg>{siteTitle}</a>
{sections.length > 0 && <nav class="sections" aria-label={t.sections}>
	{sections.map((s) => <a href={s.href} aria-current={s.current ? 'true' : undefined}>{s.label}</a>)}
</nav>}

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		font-weight: 700;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	/* The site's icon, the same drawing as public/favicon.svg, in the theme's colours.
	   Inline SVG so that it follows the theme buttons; check-dist strips svg from text. */
	.site-icon {
		flex: none;
		margin-inline-end: 0.6em;
		width: 1.4em;
		height: 1.4em;
	}
	.site-icon .ground {
		fill: var(--sl-color-accent);
	}
	.site-icon .mark {
		stroke: var(--sl-color-black);
	}
	.site-icon .glyph {
		fill: var(--sl-color-black);
	}
	.site-title::after {
		content: '█';
		margin-inline-start: 0.15em;
		color: var(--sl-color-accent);
		animation: blink 1.2s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.site-title::after {
			animation: none;
		}
	}
	.sections {
		display: none;
		gap: 1.25rem;
		margin-inline-start: 2rem;
		font-size: var(--sl-text-xs);
		white-space: nowrap;
	}
	@media (min-width: 72rem) {
		.sections {
			display: flex;
		}
	}
	.sections a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	/* The section of the current page, in the accent colour. */
	.sections a[aria-current] {
		color: var(--sl-color-white);
		box-shadow: inset 0 -1px 0 var(--sl-color-accent);
	}
	.sections a:hover,
	.sections a:focus-visible {
		color: var(--sl-color-white);
	}
</style>
